#!/usr/bin/env bash

valid_displays() {
  ddcutil detect --brief | grep "^Display" | awk '{print $2}'
}

toggle_value() {
  local d="$1"
  current_value=$(ddcutil getvcp 10 -d $d --brief | awk '{print $4}')
  if [ "$current_value" -eq 100 ] ; then
    echo 50
  else
    echo 100
  fi
}

displays=$(valid_displays)

if [ -n "$1" ]; then
  next_value="$1"
else
  next_value=$(toggle_value $displays)
fi

for d in $displays ; do
  ddcutil setvcp 10 $next_value -d $d &
done

notify-send "🔆  Brightness set to $next_value"
