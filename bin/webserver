#!/usr/bin/env ruby

require "bundler/inline"

gemfile do
  source "https://rubygems.org"
  gem "webrick"
end

include WEBrick

s = HTTPServer.new(
  :Port            => 2000,
  :DocumentRoot    => Dir::pwd
)

## mount subdirectories
s.mount(".", HTTPServlet::FileHandler, "/")

trap("INT"){ s.shutdown }
s.start
