#!/usr/bin/env bash
#
# Set this Omarchy machine up: packages, services, browser, editor, Tailscale.
#
# Idempotent. Run it as often as you like. Every step checks the current state
# first and changes nothing when it is already correct, so a run with nothing
# to do never asks for a password.
#
# Managed by chezmoi: home/dot_local/bin/executable_omarchy-recipe
#
# Usage: omarchy-recipe
#

set -euo pipefail

# One list. yay covers the Arch repos and the AUR, so packages from either
# source go here and do not need to be kept apart.
#
# Chromium is deliberately absent: it is installed through Omarchy's own
# browser installer below, which also wires up the flags and extensions.
PACKAGES=(
  emacs-wayland       # Emacs, PGTK build, the one that is native on Wayland
  figlet              # big ASCII-art banner text
  fwupd               # firmware updates via LVFS (fwupdmgr)
  github-cli          # gh, for PRs and issues from the terminal
  jq                  # JSON parsing, used by this script
  omarchy-emacs       # AUR: syncs the Omarchy theme and font into Emacs
  smartmontools       # SMART disk health (smartctl)
  tailscale           # mesh VPN
  the_silver_searcher # ag, fast recursive code search
)

SERVICES=( # system units
  tailscaled
)

USER_SERVICES=( # `systemctl --user` units
  emacs         # emacsclient -c talks to this daemon, and $EDITOR needs it
)

BROWSER_NAME="chromium"

# github.com has no AAAA record. That makes it the canary for a broken DNS
# search list: with no IPv6 answer to return, glibc walks the search domains,
# and one unreachable nameserver there turns a 0.3s lookup into a 10s one.
DNS_CANARY="github.com"
DNS_BUDGET_MS=2000

install_packages() {
  local pkg
  local missing=()

  for pkg in "${PACKAGES[@]}"; do
    pacman -Qq "$pkg" &>/dev/null || missing+=("$pkg")
  done

  if ((${#missing[@]} == 0)); then
    echo "packages: all ${#PACKAGES[@]} present"
    return
  fi

  echo "packages: installing ${missing[*]}"
  yay -S --needed --noconfirm "${missing[@]}"
}

enable_services() {
  local svc

  for svc in "${SERVICES[@]}"; do
    if systemctl is-enabled --quiet "$svc" && systemctl is-active --quiet "$svc"; then
      echo "service $svc: enabled and running"
    else
      echo "service $svc: enabling"
      sudo systemctl enable --now "$svc"
    fi
  done
}

enable_user_services() {
  local svc

  for svc in "${USER_SERVICES[@]}"; do
    if systemctl --user is-enabled --quiet "$svc" && systemctl --user is-active --quiet "$svc"; then
      echo "user service $svc: enabled and running"
    else
      echo "user service $svc: enabling"
      systemctl --user enable --now "$svc"
    fi
  done
}

# Omarchy's browser installer copies its own chromium-flags.conf over whatever
# is there, which would throw away the Google OAuth flags. So only install when
# the browser is genuinely missing, and always add the OAuth flags afterwards.
configure_browser() {
  if pacman -Qq "$BROWSER_NAME" &>/dev/null; then
    echo "browser: $BROWSER_NAME already installed"
  else
    echo "browser: installing $BROWSER_NAME"
    omarchy install browser "$BROWSER_NAME"
  fi

  if grep -q 'oauth2-client-id' ~/.config/chromium-flags.conf 2>/dev/null; then
    echo "browser: Google account sign-in already enabled"
  else
    echo "browser: enabling Google account sign-in"
    omarchy install chromium google account
  fi

  if [ "$(omarchy default browser)" = "$BROWSER_NAME" ]; then
    echo "browser: $BROWSER_NAME is already the default"
  else
    echo "browser: making $BROWSER_NAME the default"
    omarchy default browser "$BROWSER_NAME"
  fi
}

# The omarchy-emacs package alone does nothing. omarchy-emacs-setup is what
# writes ~/.config/emacs and installs the theme-set and font-set hooks that
# keep Emacs matching the desktop. Run it only when those hooks are missing:
# the script prompts for input if it finds a legacy ~/.emacs or ~/.emacs.d,
# and a prompt would hang an unattended run.
configure_emacs() {
  local hook="$HOME/.config/omarchy/hooks/theme-set.d/omarchy-emacs"

  if [ -e "$hook" ]; then
    echo "emacs: omarchy theme and font hooks already installed"
  else
    echo "emacs: running omarchy-emacs-setup"
    omarchy-emacs-setup
  fi

  if [ "$(cat "$HOME/.local/state/omarchy/defaults/editor" 2>/dev/null)" = "emacs" ]; then
    echo "emacs: already the omarchy default editor"
  else
    echo "emacs: making it the omarchy default editor"
    omarchy default editor emacs
  fi
}

# This tailnet pushes internal search domains and split-DNS rules that point at
# internal nameservers. Those nameservers are only reachable over subnet routes
# that peers advertise. With accept-routes off, every lookup that has to fall
# through to the search list waits for those unreachable servers to time out.
# So accept-routes is not optional here; it is what keeps DNS fast.
# `tailscale status` exits non-zero for both "logged out" and "logged in but
# stopped", which are very different problems. Read the backend state instead.
# Never fails: an unreachable daemon reports "Unknown", which callers handle.
tailscale_state() {
  tailscale status --json 2>/dev/null | jq -r '.BackendState // "Unknown"' 2>/dev/null ||
    echo "Unknown"
}

configure_tailscale() {
  local state
  state=$(tailscale_state)

  # Being logged out is worth saying loudly, but it does not stop the rest of
  # the setup, so do not abort on it.
  case "$state" in
  NoState | NeedsLogin | NeedsMachineAuth)
    echo "tailscale: not logged in (backend state: $state)" >&2
    echo "           run 'sudo tailscale up' to finish setting it up" >&2
    return 0
    ;;
  Unknown)
    echo "tailscale: cannot reach the daemon; skipping tailscale setup" >&2
    return 0
    ;;
  esac

  # Prefs usually survive a stopped backend, so this is worth setting either
  # way. There is no stable public command for reading them, so use the debug
  # one, and only write when the current value was actually readable. Guessing
  # would mean asking for a sudo password to set something already set.
  local routeall
  routeall=$(tailscale debug prefs 2>/dev/null | jq -r '.RouteAll' 2>/dev/null || echo "unknown")

  case "$routeall" in
  true)
    echo "tailscale: accept-routes already on"
    ;;
  false)
    echo "tailscale: turning accept-routes on"
    sudo tailscale set --accept-routes=true
    ;;
  *)
    echo "tailscale: cannot read prefs, leaving accept-routes alone" >&2
    ;;
  esac

  # Deliberately does not run `tailscale up` on its own. That joins a network,
  # and a stopped backend usually means someone stopped it on purpose.
  if [ "$state" = "Running" ]; then
    echo "tailscale: running"
  else
    echo "tailscale: logged in but $state; run 'sudo tailscale up' to connect"
  fi
}

verify() {
  local failures=0
  local skipped=0
  local start end ms current state


  if emacsclient --eval t &>/dev/null; then
    echo "verify: emacs daemon responds"
  else
    echo "verify: FAIL emacs daemon is not responding" >&2
    echo "        \$EDITOR is emacsclientc, which needs it" >&2
    failures=$((failures + 1))
  fi

  current=$(omarchy default browser 2>/dev/null || echo "unknown")
  if [ "$current" = "$BROWSER_NAME" ]; then
    echo "verify: default browser is $BROWSER_NAME"
  else
    echo "verify: FAIL default browser is '$current', expected '$BROWSER_NAME'" >&2
    failures=$((failures + 1))
  fi

  # Everything below only means something while Tailscale is up. The DNS stall
  # this guards against comes from the tailnet's own search domains, so with
  # the backend stopped there is nothing to measure. Skip, do not fail.
  state=$(tailscale_state)
  if [ "$state" != "Running" ]; then
    echo "verify: SKIP tailscale is '$state', so the DNS check has nothing to test"
    skipped=$((skipped + 1))
  else
    echo "verify: tailscale is running"

    # Warm the resolver cache first. A cold lookup right after the network
    # changes can take over a second on its own, and that is not the failure
    # this is looking for: the broken case is ten seconds, every single time.
    getent hosts "$DNS_CANARY" >/dev/null 2>&1 || true

    start=$(date +%s%N)
    getent hosts "$DNS_CANARY" >/dev/null 2>&1 || true
    end=$(date +%s%N)
    ms=$(((end - start) / 1000000))

    if ((ms <= DNS_BUDGET_MS)); then
      echo "verify: resolved $DNS_CANARY in ${ms}ms"
    else
      echo "verify: FAIL resolving $DNS_CANARY took ${ms}ms, budget is ${DNS_BUDGET_MS}ms" >&2
      echo "        the DNS search list probably points at unreachable servers" >&2
      echo "        inspect it with: resolvectl domain" >&2
      failures=$((failures + 1))
    fi
  fi

  ((skipped == 0)) || echo "verify: $skipped check(s) skipped"

  if ((failures > 0)); then
    echo "verify: $failures check(s) failed" >&2
    return 1
  fi
}

main() {
  install_packages
  enable_services
  enable_user_services
  configure_browser
  configure_emacs
  configure_tailscale
  verify
  echo "recipe: done"
}

main "$@"
