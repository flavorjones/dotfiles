#!/usr/bin/env bash
#
# A chezmoi "modify_" script. chezmoi feeds it the CURRENT ~/.claude/settings.json
# on stdin, and whatever it writes to stdout becomes the new file.
#
# Claude Code writes this file itself when you change the model or effort at
# runtime, so it cannot be a static managed file: an apply would revert your
# live choice. Instead this deep-merges the settings the repo owns ON TOP of
# whatever is there. Repo keys win; every other key, such as "model" and
# "modelSettings", is kept untouched. That makes it idempotent.
#

set -euo pipefail

# The settings the repo enforces on every machine. Deliberately NOT model,
# modelSettings, or effortLevel: those are per-machine and you tune them live.
read -r -d '' MANAGED <<'JSON' || true
{
  "env": {
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-sonnet-4-6",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "ENABLE_LSP_TOOL": "1"
  },
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "ruby-lsp@claude-plugins-official": true
  },
  "outputStyle": "STE",
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "autoCompactEnabled": true
}
JSON

current=$(cat)
[ -n "$current" ] || current='{}'

# jq may be absent on the first apply of a new machine, before omarchy-recipe
# has installed it. Do no harm: keep the existing file, or lay down the managed
# settings verbatim when there is no file yet. The next apply merges properly.
if ! command -v jq >/dev/null 2>&1; then
  if [ "$current" = '{}' ]; then
    printf '%s\n' "$MANAGED"
  else
    printf '%s' "$current"
  fi
  exit 0
fi

# `*` deep-merges recursively, right-hand side winning on a conflict.
jq -n --argjson cur "$current" --argjson mgd "$MANAGED" '$cur * $mgd'
