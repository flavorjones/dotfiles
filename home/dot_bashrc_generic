#
#  docker things
#
function dockerdocker {
  pwd=$(pwd)
  mount=/$(basename $pwd)-mount
  image=$1 ; shift
  echo -ne "\033]0;docker run ${*}\007"
  docker run -it --detach-keys="ctrl-@" --user=$(id -u):$(id -g) --mount=type=bind,source=${pwd},target=${mount} --workdir=${mount} ${image} bash -c "$*"
}

