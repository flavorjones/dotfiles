# Create a new worktree and branch from within current git directory.
gwta() {
  if [[ -z "$1" ]]; then
    echo "Usage: gwta [branch name]"
  else
    local branch="$1"
    local pwd="$(basename "$PWD")"
    local base="${pwd%%--*}"
    local path="../${base}--${branch}"

    if git show-ref --verify --quiet "refs/heads/$branch"; then
      git worktree add "$path" "$branch"
    else
      git worktree add -b "$branch" "$path"
    fi
    mise trust "$path"
    cd "$path"
  fi
}
 
# Remove worktree and branch from within active worktree directory.
gwtd() {
  if gum confirm "Remove worktree and branch?"; then
    local cwd base branch root
 
    cwd="$(pwd)"
    worktree="$(basename "$cwd")"


    # split on first `--`
    root="${worktree%%--*}"
    branch="${worktree#*--}"
 
    # Protect against accidentially nuking a non-worktree directory
    if [[ "$root" != "$worktree" ]]; then
      cd "../$root"
      git worktree remove "$worktree" --force
      # remove leftover ignored files (e.g. ./tmp/) that git doesn't clean up
      [[ -d "../$worktree" ]] && rm -rfv "../$worktree"
      git branch -D "$branch"
    fi
  fi
}
