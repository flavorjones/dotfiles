# ssh uses the first value it finds for each setting, so specific hosts come
# before general rules.

# on a new machine create a dedicated ssh key for the machine
# > ssh-keygen -t ed25519 -C user@host
Host github.com
  IdentityAgent none
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes

Host gateway.*.37signals.com
  User mike

Match host * exec "test -z $SSH_TTY"
  IdentityAgent ~/.1password/agent.sock

# Match all ends the block above, so the Include applies to every host.
Match all
Include ~/.ssh/*.conf
