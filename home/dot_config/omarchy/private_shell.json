{
  "bar": {
    "background": "none",
    "layout": {
      "center": [
        {
          "id": "omarchy.clock",
          "format": "ddd d MMM h:mm AP",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        }
      ],
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.workspaces"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.dropbox"
        },
        {
          "id": "37signals.hey"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.tailscale"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "temperature",
          "type": "command",
          "exec": "~/.config/omarchy/bar/scripts/temperature",
          "interval": 5
        },
        {
          "id": "cpu",
          "type": "command",
          "exec": "~/.config/omarchy/bar/scripts/cpu",
          "interval": 5,
          "onClick": "omarchy-launch-or-focus-tui btop"
        },
        {
          "id": "memory",
          "type": "command",
          "exec": "~/.config/omarchy/bar/scripts/memory",
          "interval": 5,
          "onClick": "omarchy-launch-or-focus-tui btop"
        },
        {
          "id": "omarchy.power"
        }
      ],
      "tray": [
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        }
      ],
      "centerBegin": [
        {
          "id": "omarchy.indicators"
        }
      ],
      "centerEnd": [
        {
          "id": "omarchy.elsewhen",
          "cities": [
            {
              "name": "Los Angeles",
              "zone": "America/Los_Angeles"
            },
            {
              "name": "New York",
              "zone": "America/New_York"
            },
            {
              "name": "London",
              "zone": "Europe/London"
            },
            {
              "name": "Madrid",
              "zone": "Europe/Madrid",
              "lat": 40.4165,
              "lon": -3.70256,
              "region": "ES"
            },
            {
              "name": "Tokyo",
              "zone": "Asia/Tokyo"
            }
          ]
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ]
    },
    "position": "top"
  },
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [],
  "version": 1
}
