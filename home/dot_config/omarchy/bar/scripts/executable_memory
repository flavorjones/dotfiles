#!/bin/bash

awk '
  /^MemTotal:/     { total = $2 }
  /^MemAvailable:/ { available = $2 }
  END {
    used = total - available
    percentage = int(100 * used / total + 0.5)
    printf "{\"text\":\"󰘚 %d%%\",\"tooltip\":\"%.1fG / %.1fG (%d%%)\"}\n", percentage, used / 1048576, total / 1048576, percentage
  }
' /proc/meminfo
